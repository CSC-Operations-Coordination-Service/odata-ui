# Development configuration: copy to .env and fill in.
# For a production host use .env.prod.example instead.
#
# Encrypts endpoint credentials at rest. Generate one with:
#   docker run --rm python:3.12-slim sh -c "pip install -q cryptography && \
#     python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'"
# Changing this key makes existing stored secrets unreadable - you would have to
# re-enter the credentials for every endpoint.
SECRET_KEY=

# Where the browser reaches the backend. Baked into the frontend bundle at build
# time, so change it before `docker compose build`, not after.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Origins the backend accepts browser requests from. Must include the address you
# actually type - localhost and 127.0.0.1 are different origins to a browser.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Host ports.
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Optional: pin the local image tags built by `docker compose build`.
# BACKEND_IMAGE=odata-ui-backend:local
# FRONTEND_IMAGE=odata-ui-frontend:local
