# Copy to .env on the swarm manager and fill in. Development uses .env.example.
#
# `docker stack deploy` does NOT read .env, so export it into the shell first:
#
#   set -a && . ./.env && set +a
#   docker stack deploy -c odata-ui.stack.yml odata-ui-prod
#
# (Do not try `docker compose config | docker stack deploy -c -` instead: compose
# renders the published port as a quoted string and the stack parser rejects it.)

# Registry holding the images built by CI, WITH a trailing slash - the value of the
# NEXUS_DOCKER_REGISTRY_PROD secret plus "/". The stack file appends
# odata-ui-backend / odata-ui-frontend directly, so the slash must be part of this
# value (the stack parser cannot append it conditionally).
#
# Leave EMPTY to run images already loaded into each node's local image store
# (docker save | docker --context <node> load). Then deploy with:
#   docker stack deploy --resolve-image never -c odata-ui.stack.yml odata-ui-prod
# Without --resolve-image never, swarm resolves the bare tag against Docker Hub.
IMAGE_PREFIX=

# The release to run. Deploy and roll back by changing this. Do not use "latest": it
# makes the running version unknowable and turns a restart into a deploy.
IMAGE_TAG=

# Which node holds the database volume, by node label - the same convention as the
# other stacks here (node.labels.role, node.labels.replicas).
#
# SQLite lives on a node-local volume, so the backend task must always be scheduled
# back onto the same node: without this a reschedule silently starts with an empty
# database. The role label alone is not enough when several nodes share it, which is
# why the replicas label pins it down to one. If exactly one node carries the role
# label, drop the second constraint from odata-ui.stack.yml and ignore
# DB_NODE_REPLICA.
#
# role is one of database, maas, manager, worker.
DB_NODE_ROLE=database
DB_NODE_REPLICA=replicas-01

# No port variable any more: the stack publishes nothing at all. The frontend is
# reached through the swarm Traefik ingress on
#
#   http://<NODE_IP>/odata-ui/frontend
#
# which requires the external overlay network the ingress stack uses, created once
# per cluster:
#
#   docker network create --driver overlay traefik
#
# The path is baked into the frontend image (BASE_PATH), so changing it means
# rebuilding, not just editing the router rule in odata-ui.stack.yml.

# SECRET_KEY is NOT set here. It is a swarm secret, so it stays out of the service
# spec and `docker service inspect` cannot reveal it. Create it once per cluster:
#
#   KEY=$(docker run --rm python:3.12-slim sh -c "pip install -q cryptography && \
#     python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'")
#   printf '%s' "$KEY" | docker secret create odata_ui_secret_key -
#
# BACK THE KEY UP alongside the odata-ui-prod_odata-ui-data volume, and back them up
# together: the volume holds the encrypted credentials, the key decrypts them, and
# either one alone is useless. Losing the key means re-entering every endpoint's
# credentials by hand.

# Not set in production:
#   NEXT_PUBLIC_API_URL - baked into the image by CI as the ingress path, so the
#                         browser calls the frontend origin under its own prefix.
#   BASE_PATH           - baked in the same way; both are build args, not runtime
#                         settings, and cannot be changed on a running container.
#   CORS_ORIGINS        - empty; the browser only ever talks to the frontend.
#   FRONTEND_PORT       - nothing is published; Traefik is the only way in.
#   BACKEND_PORT        - the backend publishes no port.
